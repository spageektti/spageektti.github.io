---
import BaseLayout from "@/layouts/BaseLayout.astro";

import {
  getPosts,
  postPath,
  writingPath,
  feedPath,
  formatDate,
} from "@/lib/writing";

import { getAlternateLocale, type Locale } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const posts = await getPosts(locale);

const t = {
  en: {
    title: "Writing",
    description: "Articles, notes and thoughts on things I find interesting.",
    empty: "Nothing has been published here yet.",
    rss: "RSS feed",
  },
  pl: {
    title: "Teksty",
    description:
      "Artykuły, notatki i przemyślenia na tematy, które mnie interesują.",
    empty: "Nie opublikowałem tutaj jeszcze żadnych tekstów.",
    rss: "Kanał RSS",
  },
}[locale];
---

<BaseLayout
  title={t.title}
  description={t.description}
  locale={locale}
  alternatePath={writingPath(getAlternateLocale(locale))}
>
  <div class="container writing-container">
    <header class="page-header">
      <h1>{t.title}</h1>

      <p>{t.description}</p>

      <a class="rss-link" href={feedPath(locale)}>
        {t.rss}
      </a>
    </header>

    {posts.length === 0 ? (
      <p class="muted">{t.empty}</p>
    ) : (
      <ul class="post-list">
        {posts.map(({ data }) => (
          <li class="post">
            <time datetime={data.published.toISOString().slice(0, 10)}>
              {formatDate(data.published, locale)}
            </time>

            <div class="post-copy">
              <h2>
                <a href={postPath(data.key, locale)}>{data.title}</a>
              </h2>

              <p>{data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .writing-container {
    padding-block: var(--section-spacing);
  }

  .page-header {
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .page-header p {
    max-width: 55ch;
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: 1.125rem;
    text-wrap: pretty;
  }

  .rss-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.875rem;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .post {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1rem 3rem;
    align-items: baseline;
    padding-block: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  time {
    color: var(--color-muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .post h2 {
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    overflow-wrap: anywhere;
  }

  .post h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .post h2 a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .post-copy p {
    margin-top: 0.65rem;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  @media (max-width: 640px) {
    .post {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }
  }
</style>
