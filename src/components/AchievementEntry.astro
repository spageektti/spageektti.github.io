---
import { Image } from "astro:assets";

import type { Achievement } from "@/content/achievements";
import type { Locale } from "@/i18n/ui";

interface Props {
  achievement: Achievement;
  locale: Locale;
}

const { achievement, locale } = Astro.props;

const { title, result, description, photo, sources } = achievement;

const t = {
  en: {
    sources: "Sources and publications",
    credit: "Photo",

    sourceTypes: {
      results: "Official results",
      press: "Press coverage",
      certificate: "Certificate",
      other: "Related material",
    },
  },

  pl: {
    sources: "Źródła i publikacje",
    credit: "Fot.",

    sourceTypes: {
      results: "Oficjalne wyniki",
      press: "Materiał prasowy",
      certificate: "Dyplom lub zaświadczenie",
      other: "Powiązany materiał",
    },
  },
}[locale];

const imageWidth = photo ? Math.min(photo.src.width, 800) : 0;

const imageWidths = photo
  ? [
      ...[280, 360, 480, 560, 720].filter((width) => width < imageWidth),
      imageWidth,
    ]
  : [];
---

<article class:list={["achievement", { "has-photo": Boolean(photo) }]}>
  <div class="achievement-copy">
    <h3>{title[locale]}</h3>

    <p class="result">{result[locale]}</p>

    {description && <p class="description">{description[locale]}</p>}

    {sources && sources.length > 0 && (
      <section class="sources">
        <h4>{t.sources}</h4>

        <ul class="source-list">
          {sources.map((source) => (
            <li>
              <a href={source.url}>{source.title}</a>

              <small>
                {source.publisher ? `${source.publisher} — ` : ""}

                {t.sourceTypes[source.type]}
              </small>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  {photo && (
    <figure class="achievement-photo">
      <Image
        src={photo.src}
        alt={photo.alt[locale]}
        width={imageWidth}
        widths={imageWidths}
        sizes="(max-width: 760px) min(360px, calc(100vw - 2 * clamp(1.25rem, 4vw, 3rem))), 280px"
        layout="constrained"
        format="webp"
        quality={80}
        loading="lazy"
        decoding="async"
      />

      {(photo.caption || photo.credit) && (
        <figcaption>
          {photo.caption && <span>{photo.caption[locale]}</span>}

          {photo.credit && (
            <span class="credit">
              {t.credit}: {photo.credit}
            </span>
          )}
        </figcaption>
      )}
    </figure>
  )}
</article>

<style>
  .achievement {
    min-width: 0;
  }

  .achievement.has-photo {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 280px);
    align-items: start;
    gap: 2rem 2.5rem;
  }

  .achievement-copy {
    min-width: 0;
  }

  h3 {
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    overflow-wrap: anywhere;
  }

  .result {
    margin-top: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .description {
    max-width: 65ch;
    margin-top: 0.75rem;
    color: var(--color-muted);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .sources {
    margin-top: 1.75rem;
  }

  .sources h4 {
    margin-bottom: 1rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: normal;
  }

  .source-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .source-list a {
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  .source-list small {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .achievement-photo {
    width: 100%;
    margin: 0;
  }

  .achievement-photo img {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  figcaption span {
    display: block;
  }

  .credit {
    margin-top: 0.25rem;
  }

  @media (max-width: 760px) {
    .achievement.has-photo {
      grid-template-columns: minmax(0, 1fr);
    }

    .achievement-photo {
      max-width: 360px;
    }
  }

  @media print {
    .achievement {
      break-inside: avoid;
    }
  }
</style>
